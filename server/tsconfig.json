{
  "compilerOptions": {
    "skipLibCheck": true,
    "target": "ESNext",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "strict": true,

    "outDir": "dist",
    "rootDir": ".",

    "verbatimModuleSyntax": true,
    
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "prisma"]    
}